# Plataforma / providers globales
LOG_LEVEL=DEBUG
# Modo "sólo kernel": registra los módulos UI pero no compila ni levanta sus servidores
# (~27 procesos hijos de bundler menos). Lo usa `driver.mjs boot-check` para validar el
# arranque del kernel; no dejarlo activo para desarrollo normal, no habría UI servida.
ADC_NO_UI_SERVERS=false
# Variante POR APP del anterior: lista blanca de módulos UI a compilar. Vacío = todos
# (default). Las UI libraries (Stencil) se compilan siempre aunque no estén listadas:
# son la dependencia contra la que bundlean los hosts.
#   ADC_UI_APPS=adc-home,adc-drive
ADC_UI_APPS=
# Boot dirigido a nivel CARGA (el anterior es sólo de build: las apps fuera de ADC_UI_APPS se
# cargan igual, con sus providers y conexiones). Las apps fuera de esta lista ni se cargan.
# Se expande al cierre transitivo de `uiDependencies` y las UI libraries entran siempre, así
# que basta nombrar la app bajo prueba. Vacío = todas (default). Lo que queda afuera se
# reporta `dormant`, no caído: la status page no se pone roja por un boot dirigido.
#   ADC_LOAD_APPS=adc-drive
ADC_LOAD_APPS=
# Source maps por módulo en los bundles de desarrollo (`eval-cheap-module-source-map`). Por
# defecto el devtool de dev es `eval` pelado, que es el más barato en rebuild incremental; el
# precio es que los stack traces apuntan al módulo transpilado y no al `.tsx`. Prendelo mientras
# depurás. No afecta a producción, donde el devtool es `false` y tiene que seguir siéndolo: la
# CSP omite 'unsafe-eval' de script-src justamente porque el build de prod no usa `eval-*`.
ADC_UI_SOURCEMAPS=false
# Diferir el build de los módulos UI "hoja" (los que nadie declara como dependencia UI ni consume
# como remote) fuera del `start()` de su app; el kernel los drena antes de terminar el arranque.
# Activo por default. `false` vuelve al comportamiento anterior en una corrida, para descartar el
# diferimiento como causa de un problema de orden de build.
ADC_DEFER_UI_BUILDS=true
# Árbol `src/apps/test` (8 apps, un bundler cada una). Fuera de `bun run dev:tests` no se
# carga ni en desarrollo. Los puertos 3001-3006 quedan libres.
ENABLE_TESTS=false
# Techo de apps cargándose a la vez durante el arranque. Sin definir: min(4, CPUs-1), con
# freno automático por presión de memoria. `1` restaura el arranque serial exacto de antes.
# BOOT_MAX_PARALLEL=4
# Instrumentación del arranque: fases a `temp/boot-timings.jsonl` + líneas BOOT-PHASE en
# nivel DEBUG. `false` la apaga por completo.
ADC_BOOT_TIMELINE=true
# Caché persistente de rspack en `temp/rspack-cache` (aislada por versión de rspack, modo y
# módulo; se invalida sola por hash de fuentes, configs generadas y `bun.lock`). `false` la
# apaga. Para vaciarla: `POST /api/modules/ui-cache/clear` (los deploys por git ya la vacían).
ADC_RSPACK_CACHE=true
# Redis compartido (rate limit, jobs, caché de permisos, estado de sesión, moderación). Un
# solo endpoint para todos los consumidores: cada uno se separa por `keyPrefix` en su
# config.json, no por instancia. El 6380 es el puerto del HOST: `adc-redis-core` publica ahí
# el 6379 del contenedor.
REDIS_HOST=localhost
REDIS_PORT=6380
# Contraseña de Redis. Vacío = sin autenticación (default histórico). Los secretos de
# sesión que viven ahí van cifrados igual: esto es defensa en profundidad, no el candado.
REDIS_PASSWORD=
# Interfaz en la que `adc-minio-core` publica el 9000. Es el único servicio de infra que
# abre el NAVEGADOR (subidas/descargas con URL presignada), así que para probar desde otro
# dispositivo de la LAN hay que ponerlo en `0.0.0.0`; la URL firmada ya sigue sola el host
# por el que entró el cliente. Fuera de eso, dejarlo en loopback: el MinIO local corre con
# credenciales de desarrollo.
MINIO_BIND_HOST=127.0.0.1

# Mongo: el clúster se configura UNA vez acá y cada módulo declara sólo su `db` en su
# config.json (`adc-identity`, `adc-plans`, `adc-drive`, …). Todas comparten una única
# conexión física: son vistas lógicas, no conexiones distintas. Las mismas credenciales
# inicializan el contenedor de `src/common/docker/adc-mongo-core` (cambiarlas exige
# regenerar el volumen).
# `host` admite lista de réplicas (`h1:27017,h2:27017`). Para Atlas o un clúster externo,
# poner una `uri` completa en el `custom` del módulo, que gana sobre estas partes.
MONGO_HOST=localhost:27017
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_OPTIONS=authSource=admin
# Sólo con ENABLE_TESTS: las apps fixture usan otro contenedor
# (`src/apps/test/web-layout/docker-compose.yml`), con estas mismas credenciales.
DASHBOARD_MONGO_HOST=localhost:27018
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_URL=amqp://admin:password@localhost:5672

# Almacenamiento de objetos (internal-s3-provider: Drive, adjuntos, PM, correo).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Cuenta de SERVICIO, no el root de MinIO (MINIO_ROOT_USER/PASSWORD, que sólo usa la consola):
# el access key se publica en la firma de cada URL presignada que ve el navegador, y la cuenta
# está acotada a los buckets `adc-*`. En dev la crea `adc-minio-core` en cada `compose up`, así
# que cambiar el secreto acá y relevantar la infra alcanza para rotarla. En producción hay que
# crear el usuario IAM/service account equivalente a mano.
S3_ACCESS_KEY=adc-platform
S3_SECRET_KEY=adc-platform-dev
# Buckets por dominio (se autocrean al arrancar): DRIVE_S3_BUCKET=adc-drive,
# PM_S3_BUCKET=adc-pm, MAIL_S3_BUCKET=adc-mail. El nombre tiene que empezar con `adc-`
# o queda fuera de la política de la cuenta de servicio.

# Proxies en los que se confía para resolver la IP del cliente. CIDRs, IPs sueltas o el alias
# `cloudflare` (expande los rangos publicados del edge), separados por comas.
#
# Vacío es el default y significa no confiar en nadie: `request.ip` es la IP del socket, que es lo
# correcto en `bun run dev` (localhost o IP de LAN, sin proxy delante).
#
# Con un edge delante hay que declararlo o los bans por IP y la analítica de login registran la IP
# del edge para todos, y el rate limit los mete a todos en un único bucket. Declarado, la IP sale
# de `X-Forwarded-For` descartando los saltos confiables, y se habilita `CF-IPCountry` para la
# revocación por cambio de país (sin lista se ignora: cualquiera podría mandarlo).
#
# `true`/`*`/`all` se rechazan: confiar en cualquier peer deja que el cliente elija su propia IP.
# Lo que haya entre el edge y la plataforma (nginx, ingress) va también en la lista.
#   TRUSTED_PROXIES=cloudflare
#   TRUSTED_PROXIES=cloudflare,10.0.0.0/8
TRUSTED_PROXIES=

HTTP_BODY_LIMIT_BYTES=1048576
# Techo de los bodies `application/octet-stream` (llegan como stream y NO pasan por
# HTTP_BODY_LIMIT_BYTES). Es anti-abuso: el tope real por usuario lo pone el plan.
HTTP_RAW_BODY_LIMIT_BYTES=5368709120
# Orígenes que pueden llamar a la API con credenciales desde un navegador.
#
# **En producción real esta lista es la ÚNICA allowlist.** Registrar un vhost sirve para que la
# plataforma responda en ese host, no para volverlo un origen de API con sesión ajena; que una cosa
# implicara la otra hacía que dar de alta un dominio ampliara la superficie de la API sin que nadie
# lo decidiera (y con `subdomains: ["*"]`, cualquier subdominio). Si tus apps viven en varios
# subdominios y se llaman entre sí, hay que enumerarlos acá o las llamadas cruzadas fallan; el
# kernel avisa al arrancar si esto queda vacío en producción.
#
# Fuera de producción real (dev y `start:prodtests`) se aceptan además los orígenes locales y los
# vhosts concretos registrados, porque en dev cada app vive en su propio puerto.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:3012,http://localhost:3014,http://localhost:3016,http://localhost:3018
# Perfil de seguridad degradado con `NODE_ENV=production`. Lo pone SOLO `bun run start:prodtests`
# para ejercitar los caminos de prod en la máquina del desarrollador: apaga las cookies `Secure`,
# HSTS y la CSP enforced, y deja que el cifrado en reposo derive un KEK de desarrollo en vez de
# exigir ADC_STORAGE_MASTER_KEY.
#
# **Nunca en un deploy real.** Antes este rol lo cumplía `PROD_PORT=3000`, o sea que un deploy
# servido en :3000 (lo normal detrás de un proxy, sin privilegios) se degradaba solo y en
# silencio. Ahora `NODE_ENV=production` alcanza para el perfil estricto: olvidarse de esta
# variable endurece, no ablanda. El kernel imprime el perfil resuelto al arrancar
# (`SECURITY PROFILE: …`).
ADC_LOCAL_PROD=false
# CSP: sin definir se enforcea en producción real y sale como Report-Only fuera de ella.
# Definirla fuerza el modo (true = enforce, false = sólo reporte). Ídem SECURITY_ENABLE_HSTS.
SECURITY_CSP_ENFORCE=false
SECURITY_ENABLE_HSTS=false
# `script-src` va con nonce por request (el provider http lo sella sobre cada `<script>` inline
# del HTML en el último hook `onSend`). `false` vuelve a `'unsafe-inline'`: es la salida de
# emergencia si alguna página sirviera HTML por fuera de ese hook y se quedara sin ejecutar
# scripts —un nonce hace que el navegador IGNORE `'unsafe-inline'`, no conviven—.
SECURITY_CSP_SCRIPT_NONCE=true
# Master key de cifrado en reposo: adjuntos/Drive (KEK que envuelve las DEK por usuario) y
# el token de sesión de los jobs encolados. **32 bytes exactos**, en hex (64 chars) o base64;
# cualquier otra cosa hace fallar el arranque de esos caminos, no los degrada.
#   openssl rand -hex 32
# Sin definir, en dev se deriva una clave determinística y se avisa por log. En producción es
# obligatoria, y tiene que ser ESTABLE entre reinicios y réplicas: si cambia, los adjuntos ya
# cifrados quedan ilegibles y los jobs en vuelo pierden su sesión.
ADC_STORAGE_MASTER_KEY="lkjgfdoirj234oihwoefjn$%#wefsdfosifvshd"
# Pepper del hash de identidad de bans (mín. 16 chars). Va acá y no en el `.env` de
# ModerationService: la lee `@common/utils/identityHash.ts` de `process.env`, y el `.env` de
# un módulo sólo alimenta la interpolación de su config.json. Estable entre reinicios: si
# cambia, los bans vigentes dejan de matchear. Sin ella se usa una pepper de desarrollo
# (pública) y sólo se avisa por warning.
BAN_HASH_PEPPER=pepper_min_16_chars

# Correo (email-service + adc-haraka-core). Ver docs/guides/email-dns-setup.md
MAIL_HOSTNAME=mail.tudominio.com
MAIL_ROOT_DOMAIN=tudominio.com
# true = envío puenteado por vía interna (sólo buzones de *.tudominio.com).
# La recepción desde fuera no depende de esta variable.
MAIL_INTERNAL_ONLY=true
# Sólo desarrollo: entrega el correo interno directo al buzón, sin pasar por el
# MTA (útil si el puerto 25 local es otro servidor). Ver docs/guides/email-dns-setup.md
MAIL_DEV_LOOPBACK=false
MAIL_DKIM_SELECTOR=adcmail
# Compartido con el plugin adc_inbound_webhook de Haraka. Generar con
# `openssl rand -hex 32`; con menos de 32 chars el webhook entrante se deshabilita.
MAIL_INBOUND_WEBHOOK_SECRET=
