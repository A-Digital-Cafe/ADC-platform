# Dependencies
node_modules/

# Build outputs
dist/
dist-ui/

# Astro auto-generated configs (se generan en runtime por UIFederationService)
**/web-*/astro.config.mjs
# Tipos que astro sincroniza en cada build (`.astro/`), regenerables
**/.astro/

# Temporary files
temp/
.temp/
@mf-types

# Environment
.env
.env.local
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*


apps/private

# Presets externos: cada subcarpeta de `presets/` es un repo opcional
# (servicios/apps desacoplados). Se vinculan vía submódulos, worktrees
# o clones manuales. El contenido nunca debe versionarse desde este repo.
/presets/*
!presets/.gitmodules
!presets/.presets.txt
!presets/README.md

private/

# CI de seguridad centralizada: repo público propio (A-Digital-Cafe/adc-ci),
# clonado aparte. No se versiona desde este repo. Ver docs/guides/security-ci.md
adc-ci/

# Clientes de escritorio que se publican como paquetes propios (npm), cada uno
# con su repo público. No se versionan desde el monorepo. Ver docs/guides/desktop-clients.md
desktop/
**.pyc
__pycache__

chroma_db_codebase

temp-ui

# Auto-generated by scripts/generate-react-jsx.mjs
**/utils/react-jsx.ts
**/src/components.d.ts

# Material de clave DKIM del MTA: se genera por entorno, nunca se versiona.
src/common/docker/adc-haraka-core/dkim/
# Certificado STARTTLS del MTA (cert.pem/key.pem), también por entorno.
src/common/docker/adc-haraka-core/tls/

# Identidad pública del despliegue, generada desde .env (ver scripts/generate-public-env.ts)
src/common/utils/public-env.generated.ts

# Auto-generated by scripts/build-vendor-esm.mjs (React ESM auto-hospedado)
src/common/public/vendor/

# Avisos de licencia de terceros: se derivan del árbol de dependencias instalado
# (ver scripts/build-license-notices.mjs). Versionarlos garantiza que queden viejos.
src/common/public/licenses.txt
src/common/public/licenses.json

