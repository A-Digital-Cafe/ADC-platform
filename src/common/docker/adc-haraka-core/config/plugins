adc_basic_spam

# Firmado DKIM saliente (selector global) + verificación del correo entrante.
# `dkim` = haraka-plugin-dkim; el `dkim_sign` del core desapareció en Haraka 3.2.
dkim

# Entrega del correo entrante al email-service vía webhook HTTP
adc_inbound_webhook
