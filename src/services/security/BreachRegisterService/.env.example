# Plazo comprometido para notificar a la autoridad desde que se toma conocimiento del incidente
# (72 h: compromiso propio de /privacy §11 citando Res. AAIP 47/2018 y arts. 33-34 RGPD).
BREACH_AUTHORITY_DEADLINE_HOURS=72

# Cuántas horas antes del vencimiento avisar al equipo. Sin este aviso el plazo se vence en silencio.
BREACH_REMINDER_LEAD_HOURS=12

# Retención del registro del art. 33.5, en días, contada DESDE EL CIERRE del incidente
# (1825 = 5 años, prescripción genérica del art. 2560 CCyC). Un incidente abierto no caduca.
# Al cambiarlo: enmendar /privacy §5 y la actividad 16 del RAT.
BREACH_RETENTION_DAYS=1825
