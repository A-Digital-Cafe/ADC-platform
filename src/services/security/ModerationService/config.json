{
	"kernelMode": 65,
	"name": "ModerationService",
	"uiName": "Core",
	"privileges": ["identity:internal", "moderation:internal"],
	"version": "1.0.0",
	"failOnError": true,
	"providers": [
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${MONGO_HOST:-localhost:27017}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-replicaSet=rs0&authSource=admin}",
				"db": "adc-moderation"
			}
		},
		{
			"name": "queue/redis",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${REDIS_HOST:-localhost}",
				"port": "${REDIS_PORT:-6380}",
				"password": "${REDIS_PASSWORD}",
				"db": 0,
				"keyPrefix": "adc:moderation:"
			}
		},
		{
			"name": "pengubot@object/mongo",
			"version": "latest",
			"language": "typescript",
			"optional": true,
			"custom": {
				"uri": "${PENGUBOT_MONGO_URI:-}"
			}
		}
	],
	"services": [
		{
			"name": "IdentityManagerService",
			"version": "latest",
			"language": "typescript"
		},
		{
			"name": "EndpointManagerService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "OperationsService",
			"version": "latest"
		}
	],
	"private": {
		"discord": {
			"syncEnabled": "${DISCORD_BAN_SYNC_ENABLED:-true}",
			"syncIntervalMs": 86400000
		},
		"retention": {
			"loginIpTtlSeconds": 10800,
			"banRetentionDays": "${BAN_RETENTION_DAYS:-180}"
		}
	}
}
