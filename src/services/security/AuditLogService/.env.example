# AuditLogService — variables interpoladas en config.json

# Retención de cada entrada del audit log (`private.retention`, TTL de Mongo sobre `at`).
# Accountability art. 5.2 RGPD / art. 9 Ley 25.326: por defecto 730 días (2 años).
# Bajarla reduce el rastro disponible ante un requerimiento; subirla alarga la conservación
# de IDs de actores/afectados (minimización): decidirlo con criterio legal, no operativo.
AUDIT_LOG_RETENTION_DAYS=730
