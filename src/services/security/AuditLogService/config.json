{
	"kernelMode": 55,
	"name": "AuditLogService",
	"uiName": "Core",
	"version": "1.0.0",
	"failOnError": false,
	"providers": [
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${MONGO_HOST:-localhost:27017}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-authSource=admin}",
				"db": "adc-audit"
			}
		}
	],
	"services": [
		{
			"name": "EndpointManagerService",
			"version": "latest",
			"optional": true
		}
	],
	"private": {
		"retention": {
			"auditRetentionDays": "${AUDIT_LOG_RETENTION_DAYS:-730}"
		}
	}
}
