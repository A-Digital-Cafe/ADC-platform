{
	"name": "OperationsService",
	"uiName": "Core",
	"version": "1.0.0",
	"kernelMode": 45,
	"failOnError": true,
	"providers": [
		{
			"name": "queue/redis",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${REDIS_HOST:-localhost}",
				"port": "${REDIS_PORT:-6380}",
				"password": "${REDIS_PASSWORD}",
				"db": 0,
				"keyPrefix": "adc:ops:"
			}
		},
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${MONGO_HOST:-localhost:27017}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-authSource=admin}",
				"db": "adc-operations",
				"maxRetries": 5,
				"retryDelay": 5000
			}
		}
	],
	"private": {
		"idleTickSeconds": "${IDLE_TICK_SECONDS:-30}",
		"idleDefaultIntervalSeconds": "${IDLE_DEFAULT_INTERVAL_SECONDS:-300}",
		"idleBatchBudgetMs": "${IDLE_BATCH_BUDGET_MS:-2000}",
		"idleMaxBackoffMinutes": "${IDLE_MAX_BACKOFF_MINUTES:-360}",
		"idleMaxConsecutiveFailures": "${IDLE_MAX_CONSECUTIVE_FAILURES:-5}",
		"idleMaxCpuPercent": "${IDLE_MAX_CPU_PERCENT:-35}",
		"idleMaxLoadPerCore": "${IDLE_MAX_LOAD_PER_CORE:-0.7}"
	}
}
