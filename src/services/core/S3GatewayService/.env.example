# S3GatewayService — proxy reverso del object storage en el propio proceso (reemplaza nginx).
# (`S3_PUBLIC_ENDPOINT`, que hace que las URLs presignadas apunten al gateway, es infraestructura
# compartida y se documenta en el .env.example de la raíz.)

# Vhost público que atiende el gateway (ej. s3.adigitalcafe.com). Vacío = deshabilitado:
# en dev el navegador llega al Garage local directo y no hace falta proxy.
S3_GATEWAY_PUBLIC_HOST=

# host:puerto del Garage/S3 interno al que se reenvía el tráfico.
S3_GATEWAY_UPSTREAM=127.0.0.1:3900
