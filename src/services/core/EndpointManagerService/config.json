{
	"name": "EndpointManagerService",
	"uiName": "Core",
	"version": "1.0.0",
	"kernelMode": 50,
	"failOnError": true,
	"private": {
		"csrf": {
			"enabled": "${CSRF_ENABLED}",
			"secret": "${CSRF_SECRET}",
			"ttlSeconds": "${CSRF_TTL_SECONDS}",
			"secureCookie": "${CSRF_SECURE_COOKIE}"
		},
		"apiDocs": {
			"enabled": "${API_DOCS_ENABLED}"
		},
		"rateLimit": {
			"enabled": "${ENDPOINT_RATE_LIMIT_ENABLED:-true}",
			"readMax": "${ENDPOINT_RATE_LIMIT_READ_MAX:-600}",
			"mutationMax": "${ENDPOINT_RATE_LIMIT_MUTATION_MAX:-120}",
			"windowMs": "${ENDPOINT_RATE_LIMIT_WINDOW_MS:-60000}"
		},
		"metrics": {
			"enabled": "${ENDPOINT_METRICS_ENABLED:-true}",
			"flushIntervalMs": "${ENDPOINT_METRICS_FLUSH_INTERVAL_MS:-60000}",
			"retentionHours": "${ENDPOINT_METRICS_RETENTION_HOURS:-25}"
		}
	},
	"providers": [
		{
			"name": "fastify-server",
			"version": "latest",
			"language": "typescript"
		},
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${MONGO_HOST:-localhost:27017}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-replicaSet=rs0&authSource=admin}",
				"db": "adc-endpoints",
				"maxRetries": 5,
				"retryDelay": 5000
			}
		},
		{
			"name": "queue/rabbitmq",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"url": "${RABBITMQ_URL:-amqp://admin:password@localhost:5672}",
				"defaultPrefetch": 10,
				"defaultConcurrency": 5,
				"maxRetries": 4,
				"retryDelaysMs": [1000, 5000, 25000, 125000]
			}
		},
		{
			"name": "queue/redis",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${REDIS_HOST:-localhost}",
				"port": "${REDIS_PORT:-6380}",
				"password": "${REDIS_PASSWORD}",
				"db": 0,
				"keyPrefix": "adc:jobs:"
			}
		}
	],
	"services": [
		{
			"name": "SessionManagerService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "OperationsService",
			"version": "latest"
		}
	]
}
