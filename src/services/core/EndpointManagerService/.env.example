# EndpointManagerService — variables interpoladas en config.json
# (Redis y RabbitMQ se configuran en el `.env` de la raíz.)

API_DOCS_ENABLED=true

# CSRF_SECRET es obligatorio en producción y debe ser estable entre reinicios/instancias.
CSRF_ENABLED=true
CSRF_SECRET=replace-with-openssl-rand-base64-48
CSRF_TTL_SECONDS=7200
# Vacío = automático (activo sólo en producción real).
CSRF_SECURE_COOKIE=

# Rate limiting. El kill-switch global no aplica a endpoints públicos sin auth.
ENDPOINT_RATE_LIMIT_ENABLED=true
ENDPOINT_RATE_LIMIT_READ_MAX=600
ENDPOINT_RATE_LIMIT_MUTATION_MAX=120
ENDPOINT_RATE_LIMIT_WINDOW_MS=60000

# Métricas por endpoint (las lee el tab Recursos del modules-manager). Ventana MÓVIL de 24 h:
# la hora en curso se acumula en memoria y se vuelca a Redis cada `FLUSH_INTERVAL_MS`; al cerrar
# se archiva en Mongo (db `adc-endpoints`). `RETENTION_HOURS` es cuántas horas se conservan
# archivadas: el mínimo (y el default) son 25, o sea las 24 de la ventana más la que corre.
ENDPOINT_METRICS_ENABLED=true
ENDPOINT_METRICS_FLUSH_INTERVAL_MS=60000
ENDPOINT_METRICS_RETENTION_HOURS=25
