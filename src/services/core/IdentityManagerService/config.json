{
	"kernelMode": 60,
	"name": "IdentityManagerService",
	"uiName": "Cuentas",
	"privileges": ["identity:internal", "moderation:internal", "session:revoke", "audit:write", "idle:register"],
	"version": "1.0.0",
	"failOnError": true,
	"providers": [
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${MONGO_HOST:-localhost:27017}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-replicaSet=rs0&authSource=admin}",
				"db": "adc-identity",
				"maxRetries": 5,
				"retryDelay": 5000
			}
		},
		{
			"name": "object/internal-s3-provider",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"endpoint": "${S3_ENDPOINT}",
				"publicEndpoint": "${S3_PUBLIC_ENDPOINT:-}",
				"region": "${S3_REGION}",
				"accessKey": "${S3_ACCESS_KEY}",
				"secretKey": "${S3_SECRET_KEY}",
				"bucket": "${AVATARS_S3_BUCKET:-adc-avatars}",
				"presignTtl": 600
			}
		}
	],
	"utilities": [{ "name": "attachments/attachments-utility", "version": "latest" }],
	"services": [
		{
			"name": "SessionManagerService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "EndpointManagerService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "OperationsService",
			"version": "latest"
		},
		{
			"name": "ModerationService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "ProjectManagerService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "EmailService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "DriveService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "NotificationService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "content-service",
			"version": "latest",
			"optional": true
		},
		{
			"name": "SubscriptionService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "AuditLogService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "ClusterService",
			"version": "latest",
			"optional": true
		}
	],
	"private": {
		"devUserPasswords": {
			"devadmin": "${DEV_USER_PASSWORD_DEVADMIN:-devadmin123}",
			"devorgadmin": "${DEV_USER_PASSWORD_DEVORGADMIN:-devorgadmin123}",
			"devdatamanager": "${DEV_USER_PASSWORD_DEVDATAMANAGER:-devdatamanager123}",
			"devsecmanager": "${DEV_USER_PASSWORD_DEVSECMANAGER:-devsecmanager123}"
		},
		"discordGuildId": "${DISCORD_GUILD_ID}",
		"defaultRegionObjectUri": "${MONGODB_URI:-mongodb://localhost:27017/adc-platform}",
		"accountDeletion": {
			"secret": "${ACCOUNT_DELETION_SECRET:-}",
			"cancelUrl": "${ACCOUNT_DELETION_CANCEL_URL:-https://auth.adigitalcafe.com/cancel-deletion}",
			"legalArchiveRetentionDays": "${LEGAL_ACCEPTANCE_RETENTION_DAYS:-1825}"
		},
		"twoFactor": {
			"issuer": "${TWO_FACTOR_ISSUER:-ADC Platform}"
		},
		"emailChange": {
			"confirmUrl": "${EMAIL_CHANGE_CONFIRM_URL:-https://auth.adigitalcafe.com/confirm-email}"
		},
		"discordRoleMap": {
			"1402525398788739145": "Discord VIP",
			"858592931594502166": "Discord Nitro Booster"
		}
	}
}
