{
	"kernelMode": 65,
	"name": "StorageQuotaService",
	"uiName": "Core",
	"privileges": ["identity:internal", "identity:avatar"],
	"version": "1.0.0",
	"failOnError": false,
	"providers": [
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${MONGO_HOST:-localhost:27017}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-replicaSet=rs0&authSource=admin}",
				"db": "adc-storage",
				"maxRetries": 5,
				"retryDelay": 5000
			}
		}
	],
	"services": [
		{
			"name": "IdentityManagerService",
			"version": "latest"
		},
		{
			"name": "PlanService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "EndpointManagerService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "OperationsService",
			"version": "latest"
		}
	],
	"private": {
		"reconcileIntervalMs": "${STORAGE_QUOTA_RECONCILE_MS:-0}"
	}
}
