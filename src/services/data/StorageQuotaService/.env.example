# StorageQuotaService — variables interpoladas en config.json
# (Mongo se configura en el `.env` de la raíz; acá sólo va la base `adc-storage`.)

# Cada cuánto (ms) reconciliar el uso contabilizado contra lo que hay realmente en S3.
# `0` = apagado. Sólo tiene sentido programarlo donde el contador pueda quedar corrido
# (cortes a mitad de una subida, borrados fuera de la plataforma).
STORAGE_QUOTA_RECONCILE_MS=0
