{
	"uiModule": {
		"name": "layout",
		"framework": "react",
		"outputDir": "dist-ui",
		"isHost": true,
		"isRemote": false,
		"uiDependencies": ["web-ui-library", "home"],
		"devPort": 3004,
		"sharedLibs": ["react", "tailwind"],
		"i18n": true,
		"serviceWorker": true,
		"hosting": [
			{
				"domains": ["local.com"],
				"subdomains": ["cloud", "users", "config", "*"]
			}
		]
	},
	"providers": [
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${DASHBOARD_MONGO_HOST:-localhost:27018}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${DASHBOARD_MONGO_OPTIONS:-authSource=admin}",
				"db": "adc-dashboard",
				"maxRetries": 5,
				"retryDelay": 5000
			}
		}
	]
}
