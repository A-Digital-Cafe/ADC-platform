{
	"uiModule": {
		"name": "layout",
		"uiNamespace": "mobile",
		"framework": "react",
		"outputDir": "dist-ui",
		"isHost": true,
		"isRemote": false,
		"uiDependencies": ["web-ui-library-mobile", "home"],
		"devPort": 3005,
		"sharedLibs": ["react"],
		"i18n": true,
		"serviceWorker": true,
		"hosting": [
			{
				"domains": ["local.com"],
				"subdomains": ["m-cloud"]
			}
		]
	},
	"providers": [
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${DASHBOARD_MONGO_HOST:-localhost:27018}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-authSource=admin}",
				"db": "adc-dashboard",
				"maxRetries": 5,
				"retryDelay": 5000
			}
		}
	]
}
