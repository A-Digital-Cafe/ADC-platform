---
import Counter from "../components/Counter.tsx";

const title = "Astro probe";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<h1>{title}</h1>
			<p>Si ves esto, AstroStrategy generó el config y `astro build` produjo el sitio estático.</p>
			<Counter client:load />
		</main>
	</body>
</html>
