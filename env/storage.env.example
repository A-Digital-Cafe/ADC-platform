# ── env/storage ─────────────────────────────────────────────────────
# Plantilla versionada: valores de ejemplo, nunca los de un despliegue real.
# Qué va en cada archivo: env/README.md

# Redis compartido (rate limit, jobs, caché de permisos, estado de sesión, moderación). Un
# solo endpoint para todos los consumidores: cada uno se separa por `keyPrefix` en su
# config.json, no por instancia. El 6380 es el puerto del HOST: `adc-redis-core` publica ahí
# el 6379 del contenedor.
REDIS_HOST=localhost

REDIS_PORT=6380

# Dónde escucha esa Admin API. Sólo hace falta tocarlo si el Garage de este nodo no es el local.
GARAGE_ADMIN_URL=http://127.0.0.1:3903

# Cuántas copias de cada bloque guarda el almacenamiento. **Idéntica en todos los nodos**: un nodo
# con otro número se niega a arrancar (compara contra el layout guardado y aborta).
#   1 = cada dato en un solo nodo. Se rompe una máquina y se pierde su parte; el resto sigue legible.
#   3 = tres copias en tres zonas. Tolera perder un nodo entero sin perder ni bloquear nada.
#   2 = no se acepta: el quórum de escritura son las dos copias, así que perder un nodo bloquea las
#       escrituras, y cuesta el doble de disco sin tolerar fallos.
# Cambiarla en un clúster con datos NO es editar esto y reiniciar: es la operación guiada del panel
# (Red → Almacenamiento), con ventana de mantenimiento.
GARAGE_REPLICATION_FACTOR=1

# Mongo: el clúster se configura UNA vez acá y cada módulo declara sólo su `db` en su
# config.json (`adc-identity`, `adc-plans`, `adc-drive`, …). Todas comparten una única
# conexión física: son vistas lógicas, no conexiones distintas. Las mismas credenciales
# inicializan el contenedor de `src/common/docker/adc-mongo-core` (cambiarlas exige
# regenerar el volumen).
# `host` admite lista de réplicas (`h1:27017,h2:27017`). Para Atlas o un clúster externo,
# poner una `uri` completa en el `custom` del módulo, que gana sobre estas partes.
MONGO_HOST=localhost:27017

# `replicaSet` NO es opcional: `adc-mongo-core` corre como replica set de un solo miembro (`rs0`),
# no como standalone. Es lo que habilita transacciones multi-documento y change streams, y lo que
# permite sumar un miembro con `rs.add()` en caliente sin migrar datos.
MONGO_OPTIONS="replicaSet=rs0&authSource=admin"

# Nombre del replica set. Cambiarlo exige regenerar el volumen: queda escrito en los metadatos.
MONGO_REPLICA_SET=rs0

# Clúster sharded (sólo si se convirtió la topología desde el panel de red). El router escucha en
# su propio puerto y NO en el 27017: durante toda la migración el replica set sigue atendiendo en
# el suyo, y que convivan es lo que permite volver atrás cambiando una sola variable.
MONGO_CONFIG_REPLICA_SET=csrs
MONGO_MONGOS_PORT=27018

# Declara al mongod como miembro de un clúster sharded. Vacío = replica set de siempre.
# Lo pide la conversión de topología, en TODOS los nodos que alojen un miembro del replica set: sin
# esto, agregar el shard falla con «Could not find host matching read preference», un error que
# habla de preferencias de lectura y no menciona el rol por ningún lado. Ponerlo NO corta el
# servicio: un `shardsvr` que todavía no pertenece a ningún clúster sigue atendiendo directo.
MONGO_SHARDSVR=

# Sólo con ENABLE_TESTS: las apps fixture usan otro contenedor
# (`src/apps/test/web-layout/docker-compose.yml`), con estas mismas credenciales.
# Tiene opciones propias porque ESE contenedor sigue siendo standalone: si heredara
# `MONGO_OPTIONS` se llevaría el `replicaSet=rs0` y no podría conectar a ningún lado.
DASHBOARD_MONGO_HOST=localhost:27018

DASHBOARD_MONGO_OPTIONS="authSource=admin"

# API de gestión (plugin `management`): de acá sale el estado del clúster del broker en el panel
# de infraestructura. AMQP no puede responderlo — la conexión habla con UN nodo y no sabe de los
# otros. Con un nodo remoto que consume del broker del sitio principal, apunta al de ese sitio.
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672

# Tipo de las colas de trabajo. `quorum` es el default y el que conviene incluso con UN broker:
# una cola quorum funciona con un solo nodo y **gana réplicas en caliente** al clusterizar
# (`rabbitmq-queues grow <nodo> all`), sin recrearse. Nacer classic obliga después a borrarlas y
# volverlas a declarar, que es la parte cara.
# El precio con un nodo es un log Raft por cola (más IO y algo de latencia por mensaje); con
# decenas de colas es ruido, y a cambio la migración a clúster deja de existir.
# ⚠️ El tipo NO se cambia en caliente: redeclarar una cola existente con otro tipo falla con
# PRECONDITION_FAILED y el consumidor no arranca. Migrar = drenar, borrar las colas
# `q.<servicio>.*` (menos las `.retry.N`, que siguen classic a propósito) y dejar que se
# declaren de nuevo, en ventana de mantenimiento.
RABBITMQ_QUEUE_TYPE=quorum

# Almacenamiento de objetos (internal-s3-provider: Drive, adjuntos, PM, correo).
# Siempre el Garage LOCAL de este nodo: las lecturas se sirven desde la copia más cercana y
# nunca cruzan la red por un `.js` o un adjunto.
S3_ENDPOINT=http://localhost:3900

# Endpoint contra el que se firman las URLs presignadas PARA EL NAVEGADOR cuando difiere del
# interno. En producción, apuntarlo al vhost del gateway S3 de la plataforma
# (`S3GatewayService`, ej. `https://s3.adigitalcafe.com`): el proxy corre en el propio proceso
# y Garage puede quedarse en loopback (`S3_BIND_HOST=127.0.0.1`), sin nginx. Vacío = firmar
# contra S3_ENDPOINT (dev). Las operaciones server-side siempre van directo a S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

S3_REGION=sa-central-1

# Buckets por dominio (se autocrean al arrancar): DRIVE_S3_BUCKET=adc-drive,
# PM_S3_BUCKET="adc-pm, MAIL_S3_BUCKET=adc-mail. La autocreación depende de que la clave tenga"

# Bucket default (ignorar)
S3_BUCKET=

# ── Techo de venta ───────────────────────────────────────────────────────────
# Cuánto puede prometer la plataforma antes de dejar de ofrecer planes. Sin esto,
# la página de precios vende almacenamiento que el disco no sostiene.
#
# Capacidad total en bytes. Vacío o 0 = se mide el sistema de archivos de
# ADC_STORAGE_CAPACITY_PATH. Declararla sirve cuando el dato vive afuera (un
# bucket remoto) y el disco local no representa el techo real.
ADC_STORAGE_CAPACITY_BYTES=0
ADC_STORAGE_CAPACITY_PATH=/

# El margen, la sobreventa y el mínimo de disco libre NO van acá: son política del
# clúster (un solo valor para todos los nodos) y viven en la base, editables desde
# el panel de nodos. Ver `ADC_STORAGE_*_PCT` / `_OVERSUBSCRIPTION` en
# PlatformSettingsService/defaults.json.
