# ── env/network ─────────────────────────────────────────────────────
# Plantilla versionada: valores de ejemplo, nunca los de un despliegue real.
# Qué va en cada archivo: env/README.md

# Orígenes que pueden llamar a la API con credenciales desde un navegador.
#
# **En producción real esta lista es la ÚNICA allowlist.** Registrar un vhost sirve para que la
# plataforma responda en ese host, no para volverlo un origen de API con sesión ajena; que una cosa
# implicara la otra hacía que dar de alta un dominio ampliara la superficie de la API sin que nadie
# lo decidiera (y con `subdomains: ["*"]`, cualquier subdominio). Si tus apps viven en varios
# subdominios y se llaman entre sí, hay que enumerarlos acá o las llamadas cruzadas fallan; el
# kernel avisa al arrancar si esto queda vacío en producción.
#
# Fuera de producción real (dev y `start:prodtests`) se aceptan además los orígenes locales y los
# vhosts concretos registrados, porque en dev cada app vive en su propio puerto.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:3012,http://localhost:3014,http://localhost:3016,http://localhost:3018

# HTTP/2 en el propio proceso. **Se deja en `false`**: HTTP/2 y HTTP/3 los habla el borde
# (Cloudflare o el balanceador) y hasta acá llega HTTP/1.1 por la red privada.
#
# Encenderlo tira abajo el SSE de notificaciones y las rutas crudas del túnel de dispositivos —bajo
# HTTP/2 no existen las cabeceras de conexión—, y necesita `SSL_CERT_PATH`/`SSL_KEY_PATH`
# (`env/host.env`), que tienen su propia lista de roturas. Sin esas rutas se ignora y se sigue en
# HTTP/1.1. Ver docs/guides/tls-edge.md.
#
# No hay variable de HTTP/3: el servidor no lo habla (ni Fastify ni el runtime traen QUIC), así que
# sólo puede venir del borde.
# Cloudflare tunnel ya lo resuelve
HTTP2_ENABLED=false

# CSP: sin definir se enforcea en producción real y sale como Report-Only fuera de ella.
# Definirla fuerza el modo (true = enforce, false = sólo reporte). Ídem SECURITY_ENABLE_HSTS.
SECURITY_CSP_ENFORCE=false

SECURITY_ENABLE_HSTS=false

# Proxies en los que se confía para resolver la IP del cliente. CIDRs, IPs sueltas o el alias
# `cloudflare` (expande los rangos publicados del edge), separados por comas.
#
# Vacío es el default y significa no confiar en nadie: `request.ip` es la IP del socket, que es lo
# correcto en `bun run dev` (localhost o IP de LAN, sin proxy delante).
#
# Con un edge delante hay que declararlo o los bans por IP y la analítica de login registran la IP
# del edge para todos, y el rate limit los mete a todos en un único bucket. Declarado, la IP sale
# de `X-Forwarded-For` descartando los saltos confiables, y se habilita `CF-IPCountry` para la
# revocación por cambio de país (sin lista se ignora: cualquiera podría mandarlo).
#
# `true`/`*`/`all` se rechazan: confiar en cualquier peer deja que el cliente elija su propia IP.
# Lo que haya entre el edge y la plataforma (nginx, ingress) va también en la lista, y con
# `ADC_CLUSTER_GATEWAY=true` también las IPs de los otros nodos: reenvían con `X-Forwarded-For`.
#
# En producción real, con la postura de terminar TLS en el borde, el valor esperado es `cloudflare`
# (o los rangos del balanceador). El arranque avisa si queda vacío. Ver docs/guides/tls-edge.md.
#
# ⚠️ Con Cloudflare Tunnel va `loopback`, NO `cloudflare`: quien abre la conexión es el `cloudflared`
# de ESTA máquina, así que el peer es `127.0.0.1` y los rangos del edge no matchean con nadie. Es la
# única de estas variables que el túnel no elimina sino que CAMBIA, y equivocarla no falla: deja a
# toda la gente compartiendo la IP del loopback y descarta `CF-IPCountry` en silencio.
TRUSTED_PROXIES=

# `script-src` va con nonce por request (el provider http lo sella sobre cada `<script>` inline
# del HTML en el último hook `onSend`). `false` vuelve a `'unsafe-inline'`: es la salida de
# emergencia si alguna página sirviera HTML por fuera de ese hook y se quedara sin ejecutar
# scripts —un nonce hace que el navegador IGNORE `'unsafe-inline'`, no conviven—.
SECURITY_CSP_SCRIPT_NONCE=true

# ── Red privada (overlay) ───────────────────────────────────────────────────────────────────────
# El plano de control (NetBird) es OPT-IN: hay que nombrar `netbird` en `ADC_INFRA_COMPOSE` para
# que arranque, y sólo corre en el nodo primario (forzado en el código, no acá).

# Dominio por el que los peers alcanzan al plano de control. Es lo que va en `--management-url`
# del agente, así que cambiarlo obliga a re-registrar todos los peers.
ADC_NETBIRD_DOMAIN=

# ── La plataforma como proveedor de identidad (OIDC) ────────────────────────────────────────────
# `ADC_OIDC_ISSUER` es la URL PÚBLICA con la que la plataforma se identifica al emitir tokens: viaja
# adentro de cada uno y es contra lo que el consumidor valida, así que tiene que ser alcanzable
# desde el navegador de quien se loguea y desde el servicio que verifica. Vacío = proveedor apagado
# (el descubrimiento responde 404 en vez de publicar algo a medias).
ADC_OIDC_ISSUER=https://adigitalcafe.com
ADC_OIDC_TOKEN_TTL_SECONDS=900

# Origen al que Discord/Google devuelven al usuario tras aprobar (`<origen>/api/auth/callback/…`).
# **Vacío en un despliegue normal**: cae a `ADC_OIDC_ISSUER`, que ya es el origen público de este
# mismo proceso, y dos variables para la misma URL sólo se desincronizan. Existe para el caso raro
# en que el callback tenga que entrar por otro host que el emisor. En producción real ya no hay
# default a `localhost`: sin ninguna de las dos, el login con proveedor externo se rechaza con un
# error claro en vez de mandar el `code` a la máquina de quien se loguea.
# ⚠️ Cambiarla obliga a actualizar la URI registrada en el panel del proveedor: tienen que coincidir
# carácter por carácter.
SESSION_OAUTH_BASE_URL=

# ── Identidad de la red privada ─────────────────────────────────────────────────────────────────
# NetBird self-hosted NO tiene usuarios propios: la consola y el API se autentican contra un OIDC.
# Estas variables lo apuntan al proveedor de la plataforma, así que se derivan de `ADC_OIDC_ISSUER`
# y no hay un IdP más que operar. Cambiar el emisor obliga a cambiarlas todas.
NETBIRD_AUTH_OIDC_CONFIGURATION_ENDPOINT=https://adigitalcafe.com/.well-known/openid-configuration
NETBIRD_AUTH_AUTHORITY=https://adigitalcafe.com
NETBIRD_AUTH_TOKEN_ENDPOINT=https://adigitalcafe.com/api/oidc/token
NETBIRD_AUTH_PKCE_AUTHORIZATION_ENDPOINT=https://adigitalcafe.com/api/oidc/authorize
# `client_id` declarado en el `private.oidc.clients` de SessionManagerService. La audiencia es el
# mismo valor: el token se emite PARA este cliente y el plano de control lo comprueba.
NETBIRD_AUTH_CLIENT_ID=netbird
NETBIRD_AUTH_AUDIENCE=netbird
# El proveedor de la plataforma no emite refresh tokens ni scopes de API todavía.
NETBIRD_AUTH_SUPPORTED_SCOPES="openid profile email"
NETBIRD_AUTH_USER_ID_CLAIM=sub
NETBIRD_TOKEN_SOURCE=idToken
# `none`: el plano de control no consulta usuarios contra el proveedor, los crea al primer login.
# Es lo correcto acá — la lista de usuarios ya vive en la plataforma y duplicarla no aporta.
NETBIRD_MGMT_IDP=none
NETBIRD_IDP_MGMT_CLIENT_ID=

# Dominio del STUN/TURN y usuario con el que los peers se autentican contra él. Por defecto, el
# mismo dominio del plano de control.
NETBIRD_TURN_DOMAIN=
NETBIRD_TURN_USER=netbird

# Sufijo con que se resuelven los nombres de los peers dentro de la red (`torre.netbird.selfhosted`).
NETBIRD_MGMT_DNS_DOMAIN=netbird.selfhosted

# `true` apaga la política «todo con todo» que NetBird crea de fábrica. Dejarla encendida significa
# que el primer teléfono que entre a la red ve el 27017 de Mongo y el RPC del almacenamiento.
NETBIRD_MGMT_DISABLE_DEFAULT_POLICY=true

# Dónde habla el panel con el API de management. **Tiene que ser loopback**: el cliente se niega a
# construirse contra cualquier otra cosa, porque mandaría el token de administración por la red.
ADC_NETBIRD_MANAGEMENT_URL=http://127.0.0.1:33073

# Desde qué rangos se acepta canjear un token de alta de nodo. **Vacío = alta por token
# deshabilitada**, y es el default a propósito: ese flujo puede entregar los secretos compartidos
# del clúster, así que aceptarlo desde internet convertiría un token filtrado en acceso total.
# Con la overlay levantada, acá va su rango (por defecto `100.64.0.0/10`).
ADC_NODE_JOIN_CIDRS=

# ── Reparto de carga entre nodos (sin balanceador) ──────────────────────────────────────────────
# Cuando un nodo se retrasa —lo mide el retraso del event loop, no el CPU del host—, le pasa a un
# vecino menos cargado las requests cuya ruta cuesta lo bastante como para que el salto valga la
# pena. NO reparte por método: una escritura es lenta casi siempre por Mongo, que es compartido, así
# que desviarla sólo le sumaría un salto de red a la misma espera.
#
# Con un balanceador adelante esto **se autodesactiva**: la carga ya viene repartida, la presión no
# llega al umbral y la condición de entrada nunca se cumple. No hay que apagarlo al migrar.
ADC_OFFLOAD_ENABLED=true

# Presión (0-100) desde la que el nodo se considera retrasado.
ADC_OFFLOAD_HIGH_WATER=60
# Cuánta menos presión tiene que tener el vecino. Sin margen, dos nodos parejos se pasarían trabajo
# de ida y vuelta sin que ninguno mejore.
ADC_OFFLOAD_MARGIN=25
# Costo típico mínimo de la ruta, en ms. Por debajo de esto el salto cuesta más que atenderla acá.
ADC_OFFLOAD_MIN_ROUTE_MS=25
# Desviar también a otro sitio. Cruzar el WAN por una request rara vez compensa.
ADC_OFFLOAD_CROSS_SITE=false
