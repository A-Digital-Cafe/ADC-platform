# ── env/mail ────────────────────────────────────────────────────────
# Plantilla versionada: valores de ejemplo, nunca los de un despliegue real.
# Qué va en cada archivo: env/README.md

# Correo (email-service + adc-haraka-core)
MAIL_HOSTNAME=mail.tudominio.com

MAIL_ROOT_DOMAIN=tudominio.com

# Envío puenteado por vía interna: sólo a buzones de *.adigitalcafe.com.
# Recibir de fuera no depende de esto. Poner en false abre el envío externo.
MAIL_INTERNAL_ONLY=true

MAIL_DKIM_SELECTOR=adcmail

# Redis que respalda los topes de rate del MTA (config/limit.ini de adc-haraka-core). El default
# llega al contenedor por la red compartida `adc-core-net`, sin publicar nada en el host. Sólo se
# tocan si el Redis vive en otro lado. Si no contesta, se pierden los topes pero no el correo.
MAIL_REDIS_HOST=adc-redis-core
MAIL_REDIS_PORT=6379

# Usuario ACL con el que el MTA se autentica: sólo puede tocar `rate_conn:*` y `rate_rcpt_host:*`,
# y sólo con los comandos que usa el plugin. Cambiarlo obliga a cambiar el `--user` del compose de
# adc-redis-core, que es donde se define. La contraseña va en env/secrets.env (MAIL_REDIS_PASSWORD).
MAIL_REDIS_USER=haraka

# MTA-STS: obliga a los servidores remotos a entregarnos por TLS con certificado válido, en vez de
# aceptar un downgrade a texto plano. La plataforma publica la política en
# `https://mta-sts.<dominio>/.well-known/mta-sts.txt`; sin el TXT `_mta-sts` en el DNS nadie la
# busca (los dos registros, en docs/guides/email-dns-setup.md).
#
# `testing` (default): el remitente REPORTA los fallos pero entrega igual. `enforce`: un certificado
# vencido o mal emitido en el MX hace que **rechacen correo legítimo**, así que se pasa a mano
# recién con los reportes TLS-RPT limpios. `none` no publica nada.
MAIL_MTA_STS_MODE=testing
# Cuánto cachea el remitente la política, en segundos. Bajarlo antes de un cambio grande y volver a
# subirlo: mientras esté cacheada, un MX nuevo que no figure en ella no recibe correo.
MAIL_MTA_STS_MAX_AGE=604800

# Entrega por el 25 (sin auth) mientras el envío sea interno: por ese puerto el
# correo local va al webhook y el destinatario externo lo rechaza el propio MTA.
# Al abrir el envío externo: 587 + auth (ver config/plugins de adc-haraka-core).
MAIL_RELAY_PORT=

# Sólo desarrollo: entrega interna sin MTA (el :25 local es un Postfix ajeno).
MAIL_DEV_LOOPBACK=false

# Acepta el certificado TLS del relay saliente sin verificarlo. Dejar en `false`: con un
# relay alcanzado por red, `true` deja el correo saliente sin garantía de cifrado (el
# arranque lo avisa con un warning). Si el relay es loopback/LAN no se verifica igual.
MAIL_RELAY_TLS_INSECURE=false

# Retención del buzón: papelera y spam se vacían solos pasado el plazo (0 = nunca).
# Inbox, enviados y borradores NO se borran automáticamente. Los logs de envío no guardan
# destinatarios (sólo cuántos fueron, para el cupo diario) y los borra un TTL de Mongo.
MAIL_TRASH_RETENTION_DAYS=30

MAIL_SPAM_RETENTION_DAYS=30

MAIL_SEND_LOG_RETENTION_DAYS=30
