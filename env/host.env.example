# ── env/host ────────────────────────────────────────────────────────
# Plantilla versionada: valores de ejemplo, nunca los de un despliegue real.
# Qué va en cada archivo: env/README.md

# ── En qué puerto escucha el kernel en producción ───────────────────────────────────────────────
# Sólo con `NODE_ENV=production`; en desarrollo el puerto es siempre 3000. Vacía = **80**, que
# requiere privilegios: lo normal detrás de un borde (Cloudflare Tunnel, nginx) es `3000` y correr
# sin root. Cambia el puerto y NADA más: el perfil de seguridad lo decide `NODE_ENV` + `ADC_LOCAL_PROD`
# (env/build.env), así que servir en :3000 ya no degrada cookies/HSTS/CSP como hacía antes.
PROD_PORT=3000

# ── A qué interfaz se ata el puerto del kernel ──────────────────────────────────────────────────
# **Este puerto no se publica**: va la dirección de la overlay, o `127.0.0.1` si el borde corre en la
# misma máquina. Vacío = `0.0.0.0`, que es lo que hace falta en desarrollo para entrar desde el móvil
# de la LAN; en producción real el arranque avisa. Detalle en docs/guides/tls-edge.md.
#
# Con Cloudflare Tunnel el borde ES esta máquina (`cloudflared` entrega por loopback), así que acá va
# `127.0.0.1` y no hay puerto abierto que alcanzar desde afuera: el aviso deja de tener nada que
# advertir. Con más de un nodo, la dirección de la overlay, que también tienen que alcanzar los vecinos.
ADC_BIND_HOST=

# ── TLS de este nodo ────────────────────────────────────────────────────────────────────────────
# ⚠️ **Camino NO recomendado: vacías en un despliegue normal.** Terminar TLS acá adentro rompe a los
# clientes ENTRE NODOS; qué se cae exactamente, en docs/guides/tls-edge.md. Existen para un
# despliegue sin borde delante: rutas al certificado y su clave, en PEM, propias de cada máquina.
#
# Cloudflare Tunnel ya lo resuelve y es el camino recomendado: el tramo hasta Cloudflare va cifrado
# por el propio túnel, así que no hay certificado de origen que instalar ni renovar, y este puerto
# queda plano —que es lo que los clientes entre nodos necesitan—.
#
# ⚠️ El certificado se lee **una sola vez, al arrancar**. Tras renovarlo hay que reiniciar el nodo o
# seguirá sirviendo el viejo. El plano de control de la red privada monta estos mismos archivos.
SSL_CERT_PATH=
SSL_KEY_PATH=

# Publicar el 9000 de MinIO más allá del loopback para probar subidas/descargas de Drive
# desde otro dispositivo de la LAN (la URL firmada ya sigue sola el host del request).
S3_BIND_HOST=127.0.0.1

# Identificador ESTABLE del nodo (slug). Es clave en Redis, en el audit y en las afinidades de
# conexión, así que no se cambia en un nodo vivo. Vacío = hostname de la máquina.
ADC_NODE_ID=

# Etiqueta legible ("Torre del living"). Se cambia cuando quieras; no la usa nada técnico.
ADC_NODE_NAME=

# `primary` (default) corre watchers, detección de módulos nuevos, deploys git y el scheduler.
# `secondary` los apaga: carga módulos y sirve HTTP, nada más.
ADC_NODE_ROLE=primary

# Sitio: qué máquinas comparten ubicación física, o sea el mismo corte de luz y el mismo enlace.
# Es la RAÍZ de la zona de replicación del almacenamiento, no la zona entera: el panel le agrega un
# ordinal al sumar el nodo a los datos (`sa-central-1`, `sa-central-2`, …) y lo deja escrito en el
# layout de Garage. Así el sitio distingue ubicaciones y la zona distingue máquinas.
# Todos los nodos de la misma casa comparten este valor. Cambiarlo con datos adentro obliga a
# rehacer el layout.
ADC_NODE_SITE=sa-central

# Etiqueta legible del sitio ("Casa"). Libre.
ADC_SITE_NAME=

# Cómo alcanzan los otros nodos a éste (`host:puerto`). Vacío = nadie le reenvía tráfico.
ADC_NODE_ADVERTISE=

# Reenviar a los nodos vecinos lo que este nodo no sabe servir. Con un solo nodo, `false`.
# `true` activa ClusterGatewayService: los vhosts que este nodo no sirve —y las requests con
# afinidad de conexión a otro nodo— se mandan al vecino, prefiriendo el del mismo ADC_NODE_SITE.
# Necesita ADC_NODE_ADVERTISE en los otros nodos, y las IPs de los nodos en TRUSTED_PROXIES: sin
# eso `request.ip` pasa a ser la del nodo vecino (rate limit y bans por IP quedan inservibles).
ADC_CLUSTER_GATEWAY=false

# Qué stacks de `src/common/docker/` levanta ESTE nodo. Sin definir o `*` = todos (lo correcto
# con un nodo). Vacío = ninguno. Lista = sólo esos, por nombre de directorio o alias corto
# (`mongo` ≡ `adc-mongo-core`). Es lo que evita que un segundo nodo levante su propio Mongo
# vacío en paralelo sin que nada avise.
ADC_INFRA_COMPOSE=*

# Identidad de los artefactos de UI que sirve este nodo. **Vacío (default) = se calcula solo**: sha
# de HEAD del repo raíz y de cada preset + hash del lockfile, del `package.json` raíz y de la
# identidad pública que se hornea en los bundles. Sólo se pone a mano si los artefactos los produce
# un pipeline externo, porque ahí el sha describe el código pero no lo que quedó en disco.
# El primario publica el suyo como el vigente para toda la flota (Redis, `adc:cluster:build:current`)
# y el nodo que no lo tiene se saca solo de rotación: `GET /healthz` pasa a 503 `stale-build`. Es lo
# que evita que dos nodos sirvan el mismo vhost con builds distintos (404 intermitentes de chunks).
ADC_BUILD_ID=

# Interfaz del 3901 (RPC entre nodos de Garage). Con un solo nodo no hace falta abrirlo; al
# sumar el segundo va en la IP de la LAN.
GARAGE_RPC_BIND_HOST=127.0.0.1

# Con qué dirección se anuncia ESTE nodo a los otros Garage (`host:puerto`). Va de la mano de la
# línea de arriba y son fáciles de desincronizar: anunciarse por loopback y publicar en la LAN deja
# a los vecinos intentando conectarse a su propia máquina. Nunca se copia de otro nodo.
GARAGE_RPC_PUBLIC_ADDR=127.0.0.1:3901

# Capacidad que este nodo aporta al clúster de objetos. Se puede subir en caliente
# (`garage layout assign -c …` + `garage layout apply`), sin parar nada.
GARAGE_CAPACITY=10G

# Con qué dirección se anuncia el miembro al driver. `localhost:27017` sirve mientras la
# plataforma corra en el MISMO host que el contenedor. Al sumar miembros hay que reconfigurarlo
# a un host alcanzable desde todos los nodos (`nodo-a:27017`) — ver PLAN-scaling.md.
MONGO_RS_MEMBER_HOST=localhost:27017

# A qué interfaz publica el contenedor de mongod. Va de la mano de la línea de arriba y son
# fáciles de desincronizar: anunciarse por la IP de overlay y seguir publicando en loopback deja
# al miembro nuevo en `STARTUP` para siempre, porque nadie puede conectarse a la dirección que
# anuncia. El panel entrega las dos juntas al dar de alta un nodo, justamente por esto.
MONGO_BIND_HOST=127.0.0.1

# Redis: a qué interfaz publica, y de quién es réplica. Con un nodo los dos defaults son correctos.
# Con más de uno, Redis es hoy el punto único de fallo del clúster (`REDIS_HOST` de storage.env
# apunta a UNO solo y viaja a todos los nodos). El par master/réplica se arma así:
#   - en el master:  REDIS_BIND_HOST=<su ip de overlay>
#   - en la réplica: REDIS_REPLICA_OF="<ip de overlay del master> 6379"
# La promoción es manual y a propósito (ver private/guides/apagar-el-cluster.md).
REDIS_BIND_HOST=127.0.0.1
REDIS_REPLICA_OF=

# Cómo se anuncia el config server del clúster sharded, si alguna vez se convierte la topología
# desde el panel. Sólo lo levanta el nodo PRIMARIO: dos clústers de config servers son dos mapas
# distintos del mismo territorio, y el segundo empieza vacío.
MONGO_CONFIG_MEMBER_HOST=adc-mongo-shard-configsvr:27019

# Ruta cuyo sistema de archivos aloja los volúmenes de docker: es el disco que se puede llenar, y
# el que mira el barrido de integridad. Cambiala si docker vive en otro punto de montaje.
ADC_DOCKER_DATA_PATH=/var/lib/docker

# ── Alta de este nodo (sólo en una máquina virgen) ──────────────────────────────────────────────
# Con estas dos puestas, el kernel se detiene ANTES de levantar infraestructura, canja el token
# contra el clúster, escribe lo que recibe en `env/` y recién ahí sigue arrancando. El token es de
# un solo uso: tras el primer canje queda una marca en `env/.joined` y no se vuelve a intentar.
#
# Exigen `ADC_NODE_ROLE=secondary` (arriba): un primario no se da de alta contra nadie, es el que
# emite el token. Con rol primario el arranque **corta explicando**, en vez de dejar dos primarios en
# el clúster —el olvido más caro de acá, porque no fallaba nada al arrancar—.
ADC_NODE_JOIN_URL=
ADC_NODE_JOIN_TOKEN=

# Puertos e interfaz del plano de control de la overlay, si este nodo lo corre (sólo el primario).
# El de administración se queda SIEMPRE en loopback: el compose lo ata a 127.0.0.1 y no se cambia
# desde acá. Lo que sí se elige es en qué interfaz se publica lo que los peers tienen que alcanzar.
NETBIRD_BIND_HOST=0.0.0.0
NETBIRD_PUBLIC_PORT=33443
NETBIRD_ADMIN_PORT=33073
NETBIRD_RELAY_PORT=33081
NETBIRD_SIGNAL_PORT=33080

# STUN/TURN. Corre con `network_mode: host` porque necesita ver las direcciones de origen reales:
# detrás del NAT de docker, las candidatas que anuncia son internas y el hole punching falla siempre.
#
# ⚠️ Si esta máquina está detrás de NAT (lo normal en casa), hay que declarar su IP PÚBLICA acá o el
# descubrimiento no sirve de nada y todo el tráfico cae al relay: la red anda y es lenta, que es la
# forma más difícil de diagnosticar. Vacío sólo si el host tiene IP pública directa.
NETBIRD_TURN_EXTERNAL_IP=
# Rango de puertos UDP de las asignaciones del TURN. Acotado a propósito: el default de coturn abre
# 49152-65535, que en un firewall es un agujero mucho más grande del que hace falta.
NETBIRD_TURN_MIN_PORT=49152
NETBIRD_TURN_MAX_PORT=49472
