# ── env/optionals ───────────────────────────────────────────────────
# Plantilla versionada: valores de ejemplo, nunca los de un despliegue real.
# Qué va en cada archivo: env/README.md

# Cuánto se espera a que el balanceador vea el 503 antes de empezar a apagar. Sin esta pausa
# el drenaje es simbólico: las requests en vuelo mueren igual. Default: 5000 en producción,
# 0 en desarrollo (no hay balanceador a quien avisar).
# ADC_DRAIN_MS=5000

# Presupuesto para bajar CADA stack de infraestructura, por separado (mínimo 30000).
# Antes eran 10 s para los cinco juntos, lo que garantizaba el atropello: `docker compose down`
# ya tiene 10 s de gracia por contenedor, así que el reloj saltaba siempre y a mongod le llegaba
# un SIGKILL de rutina. El que se pasa se deja terminar en vez de matarlo a mitad de un flush.
# ADC_SHUTDOWN_INFRA_TIMEOUT_MS=180000

# Watchdog de última instancia del proceso entero (mínimo 30000). NO es el límite operativo:
# sólo existe para que un cierre colgado no deje el proceso zombi para siempre.
# ADC_SHUTDOWN_BUDGET_MS=600000

# De qué base importa el panel de red las etiquetas de nodo (`kernel_nodes`) la primera vez que
# arranca. Sólo importa en un despliegue anterior a que ese DAO se mudara de preset; en un clon
# nuevo no hay nada que importar y el default es inofensivo.
NETWORK_LEGACY_LABELS_DB=adc-modules-manager
